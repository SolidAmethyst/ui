---
interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			window.React = {
				createElement: function() { return null; },
				Fragment: 'Fragment',
				Component: class {},
				PureComponent: class {},
				createContext: function() { return {}; },
				forwardRef: function(fn) { return fn; },
				memo: function(fn) { return fn; }
			};
		</script>
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sora:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&family=Bebas+Neue&display=swap"
			rel="stylesheet"
		/>
		<style>
			.material-symbols-rounded.filled {
				font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
			}
			body,
			html {
				background: white;
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
			}
			body:has([data-theme='dark']),
			html:has([data-theme='dark']) {
				background: hsl(240 20% 8%);
			}
			body,
			html,
			div,
			span,
			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			p,
			button,
			input,
			textarea,
			select {
				font-family: var(--font-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
				font-feature-settings: var(--font-feature-settings, 'cv02', 'cv03', 'cv04', 'cv11');
			}
			.material-symbols-rounded {
				font-family: 'Material Symbols Rounded' !important;
			}
			#app {
				background: transparent !important;
			}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
