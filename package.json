{
	"name": "@sapphiresolid/ui",
	"version": "1.0.4",
	"type": "module",
	"description": "Beautiful Solid.js components built with Tailwind CSS",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsup",
		"build:watch": "tsup --watch",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"type-check": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"solidjs",
		"ui",
		"components",
		"tailwind",
		"typescript"
	],
	"author": "Your Name",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SapphireSolid/ui.git"
	},
	"bugs": {
		"url": "https://github.com/SapphireSolid/ui/issues"
	},
	"homepage": "https://github.com/SapphireSolid/ui#readme",
	"devDependencies": {
		"@babel/core": "^7.28.5",
		"@babel/preset-env": "^7.28.5",
		"@eslint/js": "^9.38.0",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.9.2",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"@vitest/coverage-v8": "^4.0.4",
		"autoprefixer": "^10.4.16",
		"babel-preset-solid": "^1.9.10",
		"c8": "^10.1.3",
		"eslint": "^9.38.0",
		"eslint-plugin-solid": "^0.14.5",
		"happy-dom": "^20.0.8",
		"jsdom": "^27.0.1",
		"postcss": "^8.4.32",
		"solid-js": "^1.8.0",
		"tailwindcss": "^4.1.16",
		"tsup": "^8.0.0",
		"typescript": "^5.3.0",
		"vite": "^7.1.12",
		"vite-plugin-solid": "^2.11.10",
		"vitest": "^4.0.4"
	},
	"peerDependencies": {
		"solid-js": "^1.8.0"
	},
	"dependencies": {
		"clsx": "^2.0.0",
		"tailwind-merge": "^3.3.1"
	}
}
