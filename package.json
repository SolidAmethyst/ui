{
	"name": "@sapphiresolid/ui",
	"version": "1.0.9",
	"type": "module",
	"description": "Beautiful Solid.js components built with Tailwind CSS",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"dev": "vite",
		"dev:astro": "astro dev",
		"build": "vite build",
		"build:astro": "astro build",
		"build:watch": "tsup --watch",
		"preview:astro": "astro preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"test:theme-hardcoded": "vitest run src/test/theme/hardcoded-colors.test.tsx",
		"test:theme-detailed": "vitest run src/test/theme/hardcoded-colors-detailed.test.tsx",
		"test:theme-application": "vitest run src/test/theme/theme-application.test.tsx",
		"test:visual-regression": "vitest run src/test/visual/theme-visual-regression.test.tsx",
		"test:theme-all": "npm run test:theme-hardcoded && npm run test:theme-application && npm run test:visual-regression",
		"test:global-styles": "vitest run src/test/theme/global-styles.test.tsx",
		"test:layout": "vitest run src/test/layout/**/*.test.tsx",
		"test:layout-theme": "vitest run src/test/layout/top-nav-theme.test.tsx src/test/layout/layout-integration.test.tsx",
		"test:all-theme": "npm run test:theme-all && npm run test:layout",
		"fix:themes": "bun tooling/scripts/fix-hardcoded-colors.ts",
		"fix:themes:dry": "bun tooling/scripts/fix-hardcoded-colors.ts --dry-run",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"type-check": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"solidjs",
		"ui",
		"components",
		"tailwind",
		"typescript"
	],
	"author": "Your Name",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SapphireSolid/ui.git"
	},
	"bugs": {
		"url": "https://github.com/SapphireSolid/ui/issues"
	},
	"homepage": "https://github.com/SapphireSolid/ui#readme",
	"devDependencies": {
		"@astrojs/check": "^0.9.3",
		"@astrojs/solid-js": "^4.0.0",
		"@astrojs/tailwind": "^5.1.3",
		"@babel/core": "^7.28.5",
		"@babel/preset-env": "^7.28.5",
		"@babel/traverse": "^7.28.5",
		"@eslint/js": "^9.38.0",
		"@solidjs/testing-library": "^0.8.10",
		"@tailwindcss/postcss": "^4.1.17",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^24.9.2",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"@vitest/coverage-v8": "^4.0.5",
		"astro": "^4.15.0",
		"autoprefixer": "^10.4.16",
		"babel-preset-solid": "^1.9.10",
		"c8": "^10.1.3",
		"colord": "^2.9.3",
		"eslint": "^9.38.0",
		"eslint-plugin-solid": "^0.14.5",
		"happy-dom": "^20.0.10",
		"jscodeshift": "^17.3.0",
		"jsdom": "^27.0.1",
		"postcss": "^8.4.32",
		"postcss-value-parser": "^4.2.0",
		"solid-js": "^1.8.0",
		"tailwindcss": "^4.1.16",
		"tsup": "^8.0.0",
		"typescript": "^5.3.0",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-solid": "^2.11.10",
		"vitest": "^4.0.5"
	},
	"peerDependencies": {
		"solid-js": "^1.8.0"
	},
	"dependencies": {
		"clsx": "^2.0.0",
		"cmdk-solid": "^1.1.2",
		"tailwind-merge": "^3.3.1"
	}
}
